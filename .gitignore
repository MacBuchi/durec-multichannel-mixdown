# Miscellaneous
*.class
*.log
*.pyc
*.swp
.DS_Store
.atom/
.build/
.buildlog/
.history
.svn/
.swiftpm/
migrate_working_dir/

# IntelliJ related
*.iml
*.ipr
*.iws
.idea/

# The .vscode folder contains launch configuration and tasks you configure in
# VS Code which you may wish to be included in version control, so this line
# is commented out by default.
#.vscode/

# Flutter/Dart/Pub related
**/doc/api/
**/ios/Flutter/.last_build_id
.dart_tool/
.flutter-plugins-dependencies
.pub-cache/
.pub/
/build/
/coverage/

# Symbolication related
app.*.symbols

# Obfuscation related
app.*.map.json

# Android Studio will place build artifacts here
/android/app/debug
/android/app/profile
/android/app/release

# Rust workspace build output
/target/

# Mixstack session files created during local testing
*.durecmix.json

# Local signing secrets (see secrets/README.md) — never tracked
/secrets/

# Lockfiles von Workspace-Mitgliedern. Cargo benutzt ausschliesslich die
# Wurzel-Cargo.lock und ignoriert diese hier; eingecheckt sind sie trotzdem
# schaedlich, weil GitHubs Dependency-Graph sie liest und Sicherheitswarnungen
# gegen laengst gepatchte Versionen meldet (siehe PR #136).
/rust/Cargo.lock
/engine/Cargo.lock
